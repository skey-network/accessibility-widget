{
  "compilerOptions": {
    "baseUrl": "..",
    "paths": {
      "@components/*": ["src/components/*"],
      "@constants/*": ["src/constants/*"],
      "@context/*": ["src/context/*"],
      "@hooks/*": ["src/hooks/*"],
      "@assets/*": ["src/assets/*"],
      "@utils/*": ["src/utils/*"],
      "@i18n/*": ["src/i18n/*"],
      "@scss/*": ["src/scss/*"],
      "@config": ["src/config/"],
      "@src/*": ["src/*"]
    }
  }
}
