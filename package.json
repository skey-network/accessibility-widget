{
  "name": "@skeynetwork/accessibility-widget",
  "version": "0.0.15",
  "keywords": [],
  "author": "skey-network",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/skey-network/accessibility-widget.git"
  },
  "main": "dist/lib/accessibility.cjs.js",
  "module": "dist/lib/accessibility.es.js",
  "types": "dist/lib/accessibility.d.ts",
  "exports": {
    ".": {
      "import": "./dist/lib/accessibility.es.js",
      "require": "./dist/lib/accessibility.cjs.js"
    },
    "./css": {
      "default": "./dist/lib/accessibility.css"
    }
  },
  "files": [
    "dist/lib"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build:lib": "vite build --config vite/config.lib.ts",
    "build:embed": "vite build --config vite/config.embed.ts",
    "prepare": "husky",
    "prepublishOnly": "npm run build:lib",
    "publish:github": "./scripts/publish-github.sh"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.16",
    "classnames": "^2.5.1",
    "i18next": "^25.6.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "react-i18next": "^16.3.4",
    "wouter": "^3.9.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^24.10.0",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^5.1.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-unused-imports": "^4.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "sass-embedded": "^1.93.3",
    "stylelint": "^16.26.1",
    "stylelint-config-standard-scss": "^16.0.0",
    "stylelint-scss": "^6.13.0",
    "terser": "^5.46.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.3",
    "vite": "^7.2.7",
    "vite-plugin-checker": "^0.12.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-inspect": "^11.3.3",
    "vite-plugin-svgr": "^4.5.0"
  }
}